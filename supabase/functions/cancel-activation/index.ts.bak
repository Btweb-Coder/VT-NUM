import { admin, authenticatedUser, body, handle, json, requiredString, ApiError } from '../_shared/core.ts';
Deno.serve(handle(async request => { const user=await authenticatedUser(request,false); const orderId=requiredString(await body(request),'orderId'); const db=admin(); const {data: order}=await db.from('orders').select('*').eq('id',orderId).single(); if(!order||order.user_id!==user.id) throw new ApiError(404,'ORDER_NOT_FOUND'); if(order.status!=='EXPIRED'||order.financial_status!=='RELEASED'||!order.provider_cancellation_confirmed) throw new ApiError(412,'CANCELLATION_NOT_READY'); await db.from('orders').update({status:'CANCELLED',cancelled_at:new Date().toISOString()}).eq('id',orderId).eq('status','EXPIRED'); return json({success:true,orderId,status:'CANCELLED'}); }));
